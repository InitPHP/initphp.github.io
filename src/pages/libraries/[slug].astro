---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ScrollTop from '../../components/ScrollTop.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import { libraries, type Library } from '../../data/libraries';
import { categoryOf, librariesIn } from '../../data/categories';
import { SITE, abs } from '../../data/site';

/*
  One statically rendered page per package. Before these existed the site
  was a single URL whose every link pointed at github.com, so the facts a
  reader or a search engine needs about a package — its Composer name, its
  minimum PHP version, which PSR interfaces it implements — were nowhere on
  this domain.
*/
export function getStaticPaths() {
  return libraries.map((lib) => ({ params: { slug: lib.slug }, props: { lib } }));
}

interface Props {
  lib: Library;
}

const { lib } = Astro.props;
const path = `/libraries/${lib.slug}/`;
const category = categoryOf(lib.category);
const related = librariesIn(lib.category).filter((l) => l.slug !== lib.slug);
const install = `composer require ${lib.pkg}`;

const title = `InitPHP ${lib.name} — ${lib.desc}`;

/*
  Meta descriptions are capped around 155 characters before search results
  truncate them. The install sentence is appended only when the tagline
  leaves room for it, rather than truncating either half mid-word.
*/
const withInstall = `${lib.tagline} Install with ${install}.`;
const description = withInstall.length <= 155 ? withInstall : lib.tagline;

const facts: { term: string; value: string }[] = [
  { term: 'Composer package', value: lib.pkg },
  { term: 'Latest version', value: lib.version },
  { term: 'Released', value: lib.released },
  { term: 'Requires', value: `PHP ${lib.php} (${lib.phpConstraint})` },
  { term: 'License', value: 'MIT' },
  ...(lib.psr ? [{ term: 'Implements', value: lib.psr.join(', ') }] : []),
  ...(lib.ext ? [{ term: 'PHP extensions', value: lib.ext.map((e) => `ext-${e}`).join(', ') }] : []),
  ...(lib.deps ? [{ term: 'Depends on', value: lib.deps.join(', ') }] : []),
];

const softwareSourceCode = {
  // Both types are claimed: it is source code, and it is a distributable
  // developer package. Consumers that understand only one still match.
  '@type': ['SoftwareSourceCode', 'SoftwareApplication'],
  '@id': `${abs(path)}#software`,
  name: `InitPHP ${lib.name}`,
  alternateName: lib.pkg,
  headline: lib.tagline,
  description: lib.summary,
  url: abs(path),
  codeRepository: lib.repo,
  downloadUrl: lib.packagist,
  installUrl: lib.packagist,
  programmingLanguage: { '@type': 'ComputerLanguage', name: 'PHP' },
  runtimePlatform: `PHP ${lib.php}`,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Cross-platform',
  softwareVersion: lib.version,
  datePublished: lib.released,
  dateModified: lib.released,
  license: SITE.license,
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@id': `${SITE.url}/#organization` },
  publisher: { '@id': `${SITE.url}/#organization` },
  ...(lib.psr ? { softwareRequirements: lib.psr.join(', ') } : {}),
  ...(lib.deps ? { softwareAddOn: lib.deps } : {}),
};

const breadcrumbs = {
  '@type': 'BreadcrumbList',
  '@id': `${abs(path)}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Libraries', item: abs('/libraries/') },
    { '@type': 'ListItem', position: 3, name: lib.name, item: abs(path) },
  ],
};

const webpage = {
  '@type': 'WebPage',
  '@id': `${abs(path)}#webpage`,
  url: abs(path),
  name: title,
  description,
  isPartOf: { '@id': `${SITE.url}/#website` },
  breadcrumb: { '@id': `${abs(path)}#breadcrumb` },
  mainEntity: { '@id': `${abs(path)}#software` },
  inLanguage: SITE.lang,
  dateModified: lib.released,
};
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  imageAlt={`InitPHP ${lib.name} — ${lib.desc}`}
  jsonLd={[webpage, breadcrumbs, softwareSourceCode]}
>
  <Navbar />

  <main class="lib-page">
    <Breadcrumbs
      trail={[
        { name: 'Home', path: '/' },
        { name: 'Libraries', path: '/libraries/' },
        { name: lib.name },
      ]}
    />

    <header class="lib-header">
      <div class="lib-header-icon"><Icon name={lib.icon} /></div>
      <div>
        <h1>InitPHP {lib.name}</h1>
        <p class="lib-tagline">{lib.tagline}</p>
        <div class="tags">
          <span class="tag">PHP {lib.php}</span>
          <span class="tag">MIT</span>
          <span class="tag">v{lib.version}</span>
          {lib.psr?.map((standard) => <span class="tag tag-psr">{standard}</span>)}
        </div>
      </div>
    </header>

    <section class="lib-section" aria-labelledby="install-heading">
      <h2 id="install-heading">Installation</h2>
      <CodeBlock command={install} />
      <p class="lib-note">
        Requires PHP {lib.php}. The package is published on
        <a href={lib.packagist} target="_blank" rel="noopener noreferrer">Packagist</a> as
        <code>{lib.pkg}</code>.
      </p>
    </section>

    <section class="lib-section" aria-labelledby="about-heading">
      <h2 id="about-heading">What {lib.name} does</h2>
      <p class="lib-summary">{lib.summary}</p>
    </section>

    <section class="lib-section" aria-labelledby="facts-heading">
      <h2 id="facts-heading">Package details</h2>
      <dl class="lib-facts">
        {
          facts.map((fact) => (
            <div class="lib-fact">
              <dt>{fact.term}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="lib-section" aria-labelledby="links-heading">
      <h2 id="links-heading">Source and documentation</h2>
      <div class="lib-links">
        <a href={lib.repo} target="_blank" rel="noopener noreferrer">
          <Icon name="fa6-brands:github" /> Source on GitHub
        </a>
        <a href={lib.docs} target="_blank" rel="noopener noreferrer">
          <Icon name="fa6-solid:book" /> Documentation wiki
        </a>
        <a href={lib.packagist} target="_blank" rel="noopener noreferrer">
          <Icon name="fa6-solid:box-open" /> Packagist
        </a>
      </div>
    </section>

    {
      related.length > 0 && category && (
        <section class="lib-section" aria-labelledby="related-heading">
          <h2 id="related-heading">More in {category.title}</h2>
          <ul class="lib-related">
            {related.map((other) => (
              <li>
                <a href={`/libraries/${other.slug}/`}>
                  <Icon name={other.icon} />
                  <span>
                    <strong>{other.name}</strong>
                    <small>{other.desc}</small>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>

  <Footer />
  <ScrollTop />
</BaseLayout>

<style>
  /* Matches .section's rhythm (global.css @layer components) but with the
     narrower measure a prose page needs. */
  .lib-page {
    max-width: 860px;
    margin: 0 auto;
    padding: 8rem 1.5rem 5rem;
  }

  .lib-header {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    margin: 1.5rem 0 3rem;
  }

  .lib-header-icon {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent-glow);
    border-radius: 14px;
    font-size: 1.6rem;
    color: var(--color-accent-light);
  }

  h1 {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 0.6rem;
  }

  .lib-tagline {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin: 0 0 1rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  /* Same chip as the featured cards use (baseline.html:437-446); repeated
     here because Astro scopes styles per component and this page is not a
     card. */
  .tag {
    display: inline-block;
    padding: 4px 10px;
    background: rgba(79, 140, 201, 0.12);
    color: var(--color-php-blue);
    font-size: 0.75rem;
    font-weight: 600;
    border-radius: 50px;
    font-family: var(--font-mono);
  }

  .tag-psr {
    background: var(--color-accent-glow);
    color: var(--color-accent-light);
  }

  .lib-section {
    margin-bottom: 3rem;
  }

  .lib-section h2 {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0 0 1rem;
  }

  .lib-note {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 1rem 0 0;
    line-height: 1.6;
  }

  .lib-note code {
    font-family: var(--font-mono);
    color: var(--color-accent-light);
  }

  .lib-summary {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .lib-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1px;
    margin: 0;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .lib-fact {
    padding: 1rem 1.25rem;
    background: var(--color-bg-card);
  }

  .lib-fact dt {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-text-muted);
    margin-bottom: 4px;
  }

  .lib-fact dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text-primary);
    overflow-wrap: anywhere;
  }

  .lib-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .lib-links a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-text-primary);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-chip);
    transition: border-color 0.2s, background 0.2s;
  }

  .lib-links a:hover {
    background: var(--color-bg-card-hover);
    border-color: var(--color-accent);
  }

  .lib-related {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
  }

  .lib-related a {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.9rem 1.1rem;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    color: var(--color-text-primary);
    transition: border-color 0.2s, transform 0.2s;
  }

  .lib-related a:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    color: var(--color-text-primary);
  }

  .lib-related svg {
    font-size: 1.15rem;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .lib-related span {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .lib-related strong {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .lib-related small {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 768px) {
    .lib-page {
      padding-top: 6rem;
    }

    .lib-header {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>
