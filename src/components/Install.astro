---
import { featured, libraries } from '../data/libraries';

// Derived from the featured set rather than hard-coded, so the four sample
// commands can never name a package that has been renamed or retired.
const commands = featured.slice(0, 4).map((lib) => `composer require ${lib.pkg}`);
---

<!-- .section/.section-header* are NOT defined in this file's <style> block.
     They live in src/styles/global.css's `@layer components` and reach this
     markup automatically, same as Featured/Categories/All-Libraries. -->
<section class="section install" id="install">
  <div class="section-header">
    <h2>Get Started</h2>
    <p>Install any library with Composer in seconds.</p>
  </div>
  <div class="install-box">
    <div class="install-box-header">
      <span class="install-dot"></span>
      <span class="install-dot"></span>
      <span class="install-dot"></span>
      <span>terminal</span>
    </div>
    <div class="install-box-body">
      {commands.map((cmd, i) => (
        <div class={i < commands.length - 1 ? 'mb-3' : ''}>
          <code><span class="cmd-prefix">$ </span>{cmd}</code>
        </div>
      ))}
    </div>
  </div>
  <p class="install-note">
    Every package follows the same pattern — <code>composer require initphp/&lt;package&gt;</code>. See the
    exact command, PHP requirement and documentation for each of the {libraries.length} libraries in the
    <a href="/libraries/">library catalogue</a>.
  </p>
</section>

<style>
  /* .install, baseline.html:600-602 */
  .install {
    text-align: center;
  }

  /* Spells out the install pattern for the 23 packages the terminal box
     above does not have room to name, and hands the reader the catalogue. */
  .install-note {
    max-width: 600px;
    margin: 1.5rem auto 0;
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .install-note code {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-accent-light);
  }

  .install-note a {
    color: var(--color-accent-light);
    font-weight: 600;
  }

  /* .install-box, baseline.html:604-611 */
  .install-box {
    max-width: 600px;
    margin: 0 auto;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  /* .install-box-header, baseline.html:613-620 */
  .install-box-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    background: var(--color-bg-card);
    border-bottom: 1px solid var(--color-border);
  }

  /* .install-dot, baseline.html:622-626 */
  .install-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  /* .install-dot:nth-child(1..3), baseline.html:628-630 */
  .install-dot:nth-child(1) { background: #ef4444; }
  .install-dot:nth-child(2) { background: #f59e0b; }
  .install-dot:nth-child(3) { background: #22c55e; }

  /* .install-box-header span, baseline.html:632-637. margin-left: auto
     pushes the "terminal" label to the right of the three dots. */
  .install-box-header span {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-left: auto;
    font-family: var(--font-mono);
  }

  /* .install-box-body, baseline.html:639-642 */
  .install-box-body {
    padding: 1.5rem 2rem;
    text-align: left;
  }

  /* .install-box-body code, baseline.html:644-648 */
  .install-box-body code {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--color-green);
  }

  /* .install-box-body .cmd-prefix, baseline.html:650-653. user-select: none
     keeps the "$ " prompt out of the clipboard when a command is selected. */
  .install-box-body .cmd-prefix {
    color: var(--color-text-muted);
    user-select: none;
  }
</style>
