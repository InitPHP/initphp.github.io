---
import { Icon } from 'astro-icon/components';
---

<!--
  backdrop-filter is set via an inline `style` attribute, not a utility or
  scoped <style> rule: this project's CSS pipeline runs everything through
  Lightning CSS (Vite 8's default transformer) with no browser targets
  configured, and Lightning CSS unconditionally folds
  `-webkit-backdrop-filter` into the unprefixed property alone, in every
  route tried (Tailwind's `backdrop-blur-*` utility, a component-scoped
  <style> rule, an imported global .css rule, even an `@supports` guard).
  An inline attribute skips that pipeline entirely, so it's the only way to
  keep the baseline's `-webkit-backdrop-filter` working for Safari < 18.
-->
<nav
  class="fixed top-0 right-0 left-0 z-[100] flex h-16 items-center border-b border-border bg-[rgba(10,14,23,0.85)] px-6"
  style="-webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px);"
  role="navigation"
  aria-label="Main navigation"
>
  <div class="mx-auto flex w-full max-w-[1200px] items-center justify-between">
    <a href="/" class="flex items-center gap-[10px] text-[1.2rem] font-bold text-text-primary" aria-label="InitPHP Home">
      <img
        src="/logos/initphp-icon-96.png"
        alt="InitPHP logo"
        width="32"
        height="32"
        fetchpriority="high"
        class="rounded-md"
      />
      <span class="text-accent-light">Init</span>PHP
    </a>

    <!-- Root-relative hrefs, not bare fragments: this nav also renders on
         /libraries/<slug>/, where "#categories" would resolve against the
         library page and scroll nowhere. -->
    <ul id="navLinks" class="nav-links">
      <li><a href="/libraries/">Libraries</a></li>
      <li><a href="/#categories">Categories</a></li>
      <li><a href="/#install">Install</a></li>
      <li><a href="/#faq">FAQ</a></li>
      <li>
        <a
          href="https://github.com/InitPHP"
          target="_blank"
          rel="noopener noreferrer"
          class="nav-github"
        >
          <Icon name="fa6-brands:github" /> GitHub
        </a>
      </li>
    </ul>

    <button
      id="mobileToggle"
      class="mobile-toggle"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <Icon name="fa6-solid:bars" />
    </button>
  </div>
</nav>

<style>
  /* .nav-links, baseline.html:154-159 */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
    list-style: none;
  }

  /* baseline.html:161-166 */
  .nav-links a {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.2s;
  }

  /* baseline.html:168-170 */
  .nav-links a:hover {
    color: var(--color-text-primary);
  }

  /* .nav-github, baseline.html:172-182. !important is required here:
     .nav-links a (0,3,1) outranks .nav-github (0,2,0), both unlayered, so
     specificity — not layering — decides. Verified: removing it renders
     #94a3b8 (--color-text-secondary) instead of #e2e8f0
     (--color-text-primary). Do not drop it. */
  .nav-github {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-chip);
    color: var(--color-text-primary) !important;
    font-size: 0.875rem;
    font-weight: 500;
    transition:
      background 0.2s,
      border-color 0.2s;
  }

  /* baseline.html:184-187 */
  .nav-github:hover {
    background: var(--color-bg-card-hover);
    border-color: var(--color-accent);
  }

  /* .mobile-toggle, baseline.html:189-196 */
  .mobile-toggle {
    display: none;
    background: none;
    border: none;
    color: var(--color-text-primary);
    font-size: 1.5rem;
    cursor: pointer;
  }

  /* Desktop-first: baseline's @media (max-width: 768px) override,
     baseline.html:705-726. A real media query is used, not Tailwind's
     max-md: variant: max-md: compiles to (width < 768px), which excludes
     exactly 768px, while the baseline's media query includes it. Matches
     the reasoning in Hero.astro. */
  @media (max-width: 768px) {
    .nav-links {
      display: none;
      position: absolute;
      top: 64px;
      left: 0;
      right: 0;
      flex-direction: column;
      background: rgba(10, 14, 23, 0.97);
      backdrop-filter: blur(20px);
      padding: 1.5rem;
      gap: 1rem;
      border-bottom: 1px solid var(--color-border);
    }

    .nav-links.active {
      display: flex;
    }

    .mobile-toggle {
      display: block;
    }
  }
</style>

<script>
  const toggle = document.getElementById('mobileToggle')!;
  const navLinks = document.getElementById('navLinks')!;

  toggle.addEventListener('click', () => {
    navLinks.classList.toggle('active');
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
  });

  navLinks.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      navLinks.classList.remove('active');
      toggle.setAttribute('aria-expanded', 'false');
    });
  });
</script>
