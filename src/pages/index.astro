---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import FeaturedCard from '../components/FeaturedCard.astro';
import CategoryCard from '../components/CategoryCard.astro';
import LibCard from '../components/LibCard.astro';
import Install from '../components/Install.astro';
import Footer from '../components/Footer.astro';
import ScrollTop from '../components/ScrollTop.astro';
import { featured } from '../data/featured';
import { categories } from '../data/categories';
import { libraries } from '../data/libraries';
---

<BaseLayout>
  <Navbar />
  <Hero />
  <Stats />

  <!-- Featured Libraries, baseline.html:916-1007 -->
  <section class="section featured" id="libraries">
    <div class="section-header">
      <h2>Featured Libraries</h2>
      <p>Most popular and actively maintained components in the InitPHP ecosystem.</p>
    </div>
    <div class="featured-grid">
      {featured.map((f) => <FeaturedCard {...f} />)}
    </div>
  </section>

  <!-- Categories, baseline.html:1009-1092 -->
  <section class="section categories" id="categories">
    <div class="section-header">
      <h2>Explore by Category</h2>
      <p>Find the right library for your needs, organized by functionality.</p>
    </div>
    <div class="categories-grid">
      {categories.map((c) => <CategoryCard {...c} />)}
    </div>
  </section>

  <!-- All Libraries, baseline.html:1094-1296 -->
  <section class="section" id="all-libraries">
    <div class="section-header">
      <h2>All Libraries</h2>
      <p>Every package in the InitPHP ecosystem, ready to install via Composer.</p>
    </div>
    <div class="libraries-grid">
      {libraries.map((l) => <LibCard {...l} />)}
    </div>
    <div class="view-all">
      <a href="https://github.com/orgs/InitPHP/repositories" target="_blank" rel="noopener noreferrer">
        View All Repositories <Icon name="fa6-solid:arrow-right" />
      </a>
    </div>
  </section>

  <!-- Install, baseline.html:1298-1325 -->
  <Install />

  <!-- Footer, baseline.html:1327-1343 -->
  <Footer />

  <!-- Scroll to top, baseline.html:1346-1348 -->
  <ScrollTop />
</BaseLayout>

<style>
  /* .section/.section-header* (baseline.html:347-368) are NOT defined here.
     They're shared by every remaining section (Featured/Categories/
     All-Libraries/Install), and Task 12's Install section is authored in
     its own component file, outside this file's Astro style scope — so
     they live unscoped in src/styles/global.css's `@layer components`
     instead, where every section, regardless of which file renders it,
     can reach them. See that file for the rules and the full reasoning. */

  /* .featured, baseline.html:371-375 */
  .featured {
    background: var(--color-bg-secondary);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  /* .featured-grid, baseline.html:378-384 */
  .featured-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 1.5rem;
  }

  /* Desktop-first: baseline's @media (max-width: 768px), baseline.html:704-764.
     Only the .featured-grid override in that block (744-746) applies here;
     the rest belongs to Navbar and other sections. Kept as a real CSS media
     query (matching Stats.astro's precedent from Task 8) rather than
     max-md: utilities, since .featured-grid is a class-name selector here,
     not a utility-classed element. */
  @media (max-width: 768px) {
    .featured-grid {
      grid-template-columns: 1fr;
    }
  }

  /* .categories, baseline.html:522-526 */
  .categories {
    background: var(--color-bg-secondary);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  /* .categories-grid, baseline.html:528-534 */
  .categories-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  /* Desktop-first: baseline's @media (max-width: 768px), baseline.html:752-754. */
  @media (max-width: 768px) {
    .categories-grid {
      grid-template-columns: 1fr;
    }
  }

  /* .libraries-grid, baseline.html:466-472 */
  .libraries-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }

  /* Desktop-first: baseline's @media (max-width: 768px), baseline.html:748-750. */
  @media (max-width: 768px) {
    .libraries-grid {
      grid-template-columns: 1fr;
    }
  }

  /* .view-all, baseline.html:786-789 */
  .view-all {
    text-align: center;
    margin-top: 3rem;
  }

  /* .view-all a, baseline.html:791-802. Unlayered scoped rule beats
     global.css's @layer base `a { color }`, so no !important needed. */
  .view-all a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-accent-light);
    font-weight: 600;
    font-size: 0.95rem;
    padding: 12px 28px;
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-chip);
    transition: all 0.2s;
  }

  /* .view-all a:hover, baseline.html:804-807 */
  .view-all a:hover {
    background: var(--color-accent);
    color: #fff;
  }
</style>
