---
import { Icon } from 'astro-icon/components';
import type { Library } from '../data/libraries';

type Props = Library;
const { name, slug, pkg, stars, php, psr, summary, repo, docs } = Astro.props;
---

<article class="featured-card">
  <div class="featured-card-header">
    <h3 class="featured-card-name">
      <a href={`/libraries/${slug}/`}>{name}</a>
    </h3>
    <span class="featured-card-stars" title={`${stars} GitHub stars`}>
      <Icon name="fa6-solid:star" /> {stars}
    </span>
  </div>
  <p>{summary}</p>
  <!-- The Composer name is rendered here rather than left implicit: it is
       the one fact a reader (or an answer engine) needs to act on the card,
       and previously it appeared nowhere outside the four-line terminal
       box further down the page. -->
  <p class="featured-card-pkg"><code>composer require {pkg}</code></p>
  <div class="featured-card-footer">
    <span class="tags">
      <span class="tag">PHP {php}</span>
      {psr?.map((standard) => <span class="tag tag-psr">{standard}</span>)}
    </span>
    <div class="featured-card-links">
      <a href={repo} target="_blank" rel="noopener noreferrer"><Icon name="fa6-brands:github" /> Code</a>
      <a href={docs} target="_blank" rel="noopener noreferrer"><Icon name="fa6-solid:book" /> Docs</a>
    </div>
  </div>
</article>

<style>
  /* .featured-card, baseline.html:386-393 */
  .featured-card {
    position: relative;
    padding: 2rem;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    transition: border-color 0.3s, transform 0.2s, box-shadow 0.3s;
  }

  /* .featured-card:hover, baseline.html:395-399 */
  .featured-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-3px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.3);
  }

  /* .featured-card-header, baseline.html:401-406 */
  .featured-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  /* .featured-card-name, baseline.html:408-413. Promoted from <span> to
     <h3> so the six featured packages appear in the document outline;
     margin is reset because the heading default would break the flex row. */
  .featured-card-name {
    font-size: 1.2rem;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--color-text-primary);
    margin: 0;
  }

  /* The whole heading is the link target, so it inherits the heading colour
     instead of global.css's @layer base `a { color }`. */
  .featured-card-name a {
    color: inherit;
  }

  .featured-card-name a:hover {
    color: var(--color-accent-light);
  }

  /* .featured-card-stars, baseline.html:415-422 */
  .featured-card-stars {
    display: flex;
    align-items: center;
    gap: 4px;
    color: #fbbf24;
    font-size: 0.85rem;
    font-weight: 600;
  }

  /* .featured-card p, baseline.html:424-429 */
  .featured-card p {
    color: var(--color-text-secondary);
    font-size: 0.92rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  /* The install line sits tighter to the description it belongs to than the
     1.25rem the rule above gives every other paragraph. */
  .featured-card-pkg {
    margin-top: -0.75rem;
  }

  .featured-card-pkg code {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-accent-light);
    overflow-wrap: anywhere;
  }

  /* .featured-card-footer, baseline.html:431-435. gap + wrap added because
     the left slot now holds a PHP tag plus up to three PSR tags, which
     overflowed the single-tag row the baseline assumed. */
  .featured-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  /* .tag, baseline.html:437-446 */
  .tag {
    display: inline-block;
    padding: 4px 10px;
    background: rgba(79, 140, 201, 0.12);
    color: var(--color-php-blue);
    font-size: 0.75rem;
    font-weight: 600;
    border-radius: 50px;
    font-family: var(--font-mono);
  }

  /* PSR badges reuse .tag's shape but the accent hue, so a standards claim
     reads as distinct from the PHP version requirement next to it. */
  .tag-psr {
    background: var(--color-accent-glow);
    color: var(--color-accent-light);
  }

  /* .featured-card-links, baseline.html:448-451 */
  .featured-card-links {
    display: flex;
    gap: 0.75rem;
  }

  /* .featured-card-links a, baseline.html:453-459. Unlayered scoped rule
     beats global.css's @layer base `a { color }`, so no !important needed. */
  .featured-card-links a {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  /* .featured-card-links a:hover, baseline.html:461-463 */
  .featured-card-links a:hover {
    color: var(--color-accent-light);
  }
</style>
