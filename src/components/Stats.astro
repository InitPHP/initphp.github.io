---
import { libraries } from '../data/libraries';

const stats = [
  { number: String(libraries.length), label: 'Libraries' },
  { number: 'MIT', label: 'License' },
  { number: 'PSR', label: 'Standards' },
];
---

<section class="stats" aria-label="Project statistics">
  <div class="stats-grid">
    {stats.map((s) => (
      <div class="stat-card">
        <div class="stat-number">{s.number}</div>
        <div class="stat-label">{s.label}</div>
      </div>
    ))}
  </div>
</section>

<style>
  /* .stats, baseline.html:314-316 */
  .stats {
    padding: 0 1.5rem 5rem;
  }

  /* .stats-grid, baseline.html:318-324 */
  .stats-grid {
    max-width: 800px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  /* .stat-card, baseline.html:326-332 */
  .stat-card {
    text-align: center;
    padding: 2rem 1rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
  }

  /* .stat-number, baseline.html:334-339 */
  .stat-number {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--color-accent-light);
    font-family: var(--font-mono);
  }

  /* .stat-label, baseline.html:341-346 */
  .stat-label {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-top: 0.25rem;
    font-weight: 500;
  }

  /* Desktop-first: baseline's @media (max-width: 768px), baseline.html:704-764.
     Only the .stats-grid/.stat-card/.stat-number overrides in that block
     apply here (731-742); the rest belong to Navbar and later tasks. */
  @media (max-width: 768px) {
    .stats-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 0.75rem;
    }

    .stat-card {
      padding: 1.25rem 0.5rem;
    }

    .stat-number {
      font-size: 1.75rem;
    }
  }
</style>
